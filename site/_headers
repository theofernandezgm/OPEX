# OPEX - security, caching and Early Hints headers (Cloudflare Pages format).
# NOTE: if the inline <head> script in the HTML pages is ever edited,
# the CSP sha256 hash below must be recomputed or the language pre-paint breaks.
# The CSP allows Cloudflare Web Analytics (cookieless beacon). Everything else
# is same-origin, except the contact form endpoint.
#
# connect-src includes 'self' so the Web Analytics beacon (same-origin
# /cdn-cgi/rum) is not blocked. This does NOT fix the separate JS Detections
# console error (Cloudflare injects a per-request inline script on the Free
# plan that cannot be disabled and has no stable hash to allow) - that is a
# known, accepted trade-off. See DEPLOY.md.
#
# web3forms.com (loader script) and hcaptcha.com / *.hcaptcha.com (widget,
# iframe, styles, verification calls) are allowed for the hCaptcha spam
# check on the contact form (contacto.html / en/contact.html). The
# wildcard subdomain is intentional -- hCaptcha's own CSP guidance says not
# to hardcode specific asset subdomains, since they can change without notice.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-X1GmoQmo+a0bsVUDlAiImSQyDN6yJ1b9pNkP1zD/AS8=' https://static.cloudflareinsights.com https://web3forms.com https://hcaptcha.com https://*.hcaptcha.com; style-src 'self' https://hcaptcha.com https://*.hcaptcha.com; font-src 'self'; img-src 'self'; frame-src https://hcaptcha.com https://*.hcaptcha.com; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com https://hcaptcha.com https://*.hcaptcha.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=604800

/og-image-en.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/fonts.css
  Cache-Control: public, max-age=86400

/styles.css
  Cache-Control: public, max-age=3600

/main.js
  Cache-Control: public, max-age=3600

